#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Master Pipeline Orchestrator for: {{ vid }}
# Generated automatically by pipeline architecture
# ==============================================================================

echo "=================================================================="
echo " Starting Clip-by-Clip Pipeline for: {{ vid }}"
echo "=================================================================="

{% for clip in clips %}
# ------------------------------------------------------------------------------
# CLIP {{ clip.clip_idx }}: {{ clip.title or "Clip " ~ clip.clip_idx }}
# ------------------------------------------------------------------------------
echo "==> [START] Processing Clip {{ clip.clip_idx }}/{{ clips|length }}..."

# Step 1: Extract Scenes for Clip {{ clip.clip_idx }}
{% for scene in clip.scenes %}
echo "  -> Extracting scene: {{ scene.scene_idx }}..."
bash "{{ scene.path_scene_sh }}"
{% endfor %}

# Step 2: Black Spacer for Clip {{ clip.clip_idx }}
echo "  -> Generating black spacer..."
bash "{{ clip.path_spacer_sh }}"

# Step 3: Concatenate & Tag Clip {{ clip.clip_idx }}
echo "  -> Concatenating and tagging..."
bash "{{ clip.path_clip_sh }}"

echo "==> [COMPLETE] Clip {{ clip.clip_idx }} finished successfully!"
echo ""
{% endfor %}

echo "=================================================================="
echo " Pipeline Execution Complete for {{ vid }}!"
echo "=================================================================="
