#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Scene Extraction & Encoding Script: {{ scene_idx }}
# Title: {{ scene_title }}
# ==============================================================================

MASTER_MKV="{{ path_archive_mkv }}"
TEMP_MKV="{{ path_temp_mkv }}"
OUT_MP4="{{ path_scene_mp4 }}"

echo "==> Extracting scene {{ scene_idx }} ({{ start_time }} to {{ end_time }})..."

# 1. Lossless segment extraction
ffmpeg -y -loglevel warning \
  -ss {{ start_time }} \
  -to {{ end_time }} \
  -i "$MASTER_MKV" \
  -c copy \
  -map_chapters -1 \
  -avoid_negative_ts make_zero \
  "$TEMP_MKV"

# 2. Normalize and re-encode to archive intermediate standard
ffmpeg -y -loglevel warning \
  -i "$TEMP_MKV" \
  -vf "fps={{ fps }},scale={{ resolution }}{% if crop %},crop={{ crop }}{% endif %}" \
  -c:v libx264 -crf 22 -preset slow \
  -color_primaries smpte170m -color_trc smpte170m -colorspace smpte170m \
  -c:a aac -b:a 192k \
  -force_key_frames "expr:gte(t,n_forced*1)" \
  -avoid_negative_ts make_zero \
  -use_editlist 0 \
  "$OUT_MP4"

# 3. Cleanup lossless temporary file
rm -f "$TEMP_MKV"
