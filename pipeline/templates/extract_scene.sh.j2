#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Scene Extraction & Encoding Script: {{ scene.scene_id }}
# Title: {{ scene.title }}
# ==============================================================================

MASTER_MKV="{{ scene.master_mkv_path }}"
TEMP_MKV="{{ scene.temp_mkv_path }}"
OUT_MP4="{{ scene.out_mp4_path }}"

echo "==> Extracting scene {{ scene.scene_id }} ({{ scene.start_time }} to {{ scene.end_time }})..."

# 1. Lossless segment extraction
ffmpeg -y -loglevel warning \
  -ss {{ scene.start_time }} \
  -to {{ scene.end_time }} \
  -i "$MASTER_MKV" \
  -c copy \
  -avoid_negative_ts make_zero \
  "$TEMP_MKV"

# 2. Normalize and re-encode to archive intermediate standard
ffmpeg -y -loglevel warning \
  -i "$TEMP_MKV" \
  -vf "fps={{ scene.fps }},scale={{ scene.resolution }}{% if scene.crop %},crop={{ scene.crop }}{% endif %}" \
  -c:v libx264 -crf 22 -preset slow \
  -color_primaries smpte170m -color_trc smpte170m -colorspace smpte170m \
  -c:a aac -b:a 192k \
  -force_key_frames "expr:gte(t,n_forced*1)" \
  -avoid_negative_ts make_zero \
  -use_editlist 0 \
  "$OUT_MP4"

# 3. Cleanup lossless temporary file
rm -f "$TEMP_MKV"
